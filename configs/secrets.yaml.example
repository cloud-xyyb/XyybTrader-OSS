# ─────────────────────────────────────────────────────────────────────────
# secrets.yaml 模板
# ─────────────────────────────────────────────────────────────────────────
#
# 使用方式：
#   1. `cp configs/secrets.yaml.example configs/secrets.yaml`
#   2. `chmod 600 configs/secrets.yaml`（loader 校验文件权限，group/other 可读一律拒载）
#   3. 填入真实凭据（CTP investor 账号 / Binance API key + secret）
#   4. `configs/secrets.yaml` 已在 .gitignore 中，不会被 commit
#
# 合并机制：
#   - 加载 live/backtest profile 后，若同目录存在 `secrets.yaml`，按路径
#     deep-merge 到最终 config，同路径字段覆盖主 profile 的值
#   - 因此本文件结构**必须镜像主 profile**（例如 `runtime.td.binance.api_key`），
#     而不是扁平的 `binance.api_key`
#
# 安全：
#   - 不要把 secrets.yaml 贴到聊天、日志、commit message、截图里
#   - 即使是 demo key（假钱）也不要泄露

runtime:
  md:
    # CTP 期货（SimNow / 实盘）
    ctp:
      user: ""          # SimNow investor ID
      password: ""

  td:
    # CTP 期货（SimNow / 实盘）
    ctp:
      user: ""
      password: ""

    # Binance U 本位永续（Demo Trading 或主网）
    # Demo Trading 入口：主站登录 → 右上 profile → Demo Trading → API Management
    # 生成 HMAC key；权限只勾 "Enable Futures"，不勾 Spot & Margin / Withdrawals
    binance:
      api_key: ""
      api_secret: ""
